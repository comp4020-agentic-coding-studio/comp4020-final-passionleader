{
  "name": "comp4020-final",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/main.ts",
    "build": "pnpm --filter client build",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "check:evidence": "node scripts/check-evidence.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "jsdom": "^30.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "pnpm": ">=11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-sesv2": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "marked": "^18.1.0",
    "ws": "^8.22.0"
  }
}
